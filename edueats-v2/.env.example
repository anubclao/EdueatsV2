# ── Desarrollo ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=edueat
DB_POOL_CONNECTION_LIMIT=20
DB_POOL_QUEUE_LIMIT=0
PORT=3001
NODE_ENV=development
DB_REQUIRED_ON_BOOT=false
CORS_ORIGIN=http://localhost:5173

# ── Producción (Hostinger / cPanel) ─────────────────────────
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=u652436213_EdueatApp       <- usuario MySQL del panel
# DB_PASS=TU_PASSWORD_AQUI
# DB_NAME=u652436213_Edueat          <- nombre exacto de la DB
# DB_POOL_CONNECTION_LIMIT=30        <- subir si hay picos de trafico
# DB_POOL_QUEUE_LIMIT=0              <- 0 = sin limite de cola
# PORT=3001                          <- o el puerto que asigne cPanel
# NODE_ENV=production
# DB_REQUIRED_ON_BOOT=false
# CORS_ORIGIN=https://edueats.tecnowebsupportia.com
# WEB_DIST_PATH=apps/api/dist/web    <- usar minúsculas en Linux

# Frontend runtime API base
# Dejar vacío para mismo dominio (/api), o poner URL completa si el backend
# está en otro subdominio: https://api.edueats.com
EDUEATS_API_BASE=

# ── Gmail SMTP (para envío de OTP por correo) ───────────────
# Generar contraseña de aplicación en: https://myaccount.google.com/apppasswords
# Usar contraseña de aplicación de 16 caracteres (NO la contraseña normal de Gmail)
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# OTP login
# Expiración en minutos (se recomienda entre 5 y 10)
OTP_EXPIRES_MINUTES=5
# Máximo de solicitudes OTP por ventana y por identificador (email/código)
OTP_RATE_LIMIT_MAX=3
# Ventana en milisegundos (1 hora)
OTP_RATE_LIMIT_WINDOW_MS=3600000

# Chatbot adicional
CHATBOT_LLM_ENDPOINT=https://api.groq.com/openai/v1
CHATBOT_LLM_MODEL=llama-3.3-70b-versatile
CHATBOT_API_KEY=
CHATBOT_SYSTEM_PROMPT=Eres el asistente de EduEats. Responde de forma clara y breve.
CHATBOT_FALLBACK_MSG=No encontre informacion exacta en este momento. Intenta con otra pregunta.
CHATBOT_RATE_LIMIT_PER_MINUTE=10

{
  "name": "edueats-v2",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "uuid": "^14.0.0",
    "brace-expansion": "^2.0.2",
    "fast-uri": "^3.1.0",
    "ip-address": "^10.0.1",
    "tmp": "^0.2.4",
    "nanoid": "^5.1.5",
    "ws": "^8.18.0",
    "socket.io-parser": "^5.0.0",
    "postcss": "^8.5.3",
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @edueats/web",
    "dev:api": "npm run dev -w @edueats/api",
    "build": "npm run build -w @edueats/shared && npm run build -w @edueats/api && npm run build -w @edueats/web && node scripts/sync-web-dist.mjs",
    "start": "node apps/api/dist/server.js"
  }
}

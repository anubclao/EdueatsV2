# Database
DATABASE_URL=mysql://user:password@localhost:3306/edueats

# Redis (Opcional - si no está configurado, usa caché en memoria)
# Formato: redis://[:password@]host[:port][/db-number]
# Ejemplos:
#   - redis://localhost:6379 (local sin contraseña)
#   - redis://:password@redis.example.com:6380 (con contraseña)
#   - redis://redis-cluster:6379/1 (con número de DB)
REDIS_URL=

# Sesiones distribuidas (Requerido en producción con múltiples instancias)
SESSION_SECRET=tu-secreto-de-sesion-super-seguro

# Email
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-contraseña-app

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=tu-secreto-jwt-super-seguro

# CORS
CORS_ORIGIN=http://localhost:5173

# WebSocket (Opcional - para notificaciones en tiempo real)
WEBSOCKET_PORT=3001

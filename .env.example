# ── Base de datos (Hostinger) ───────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u652436213_EdueatApp
DB_PASS=TU_PASSWORD_REAL
DB_NAME=u652436213_Edueat
DB_POOL_CONNECTION_LIMIT=20
DB_POOL_QUEUE_LIMIT=0

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
DB_REQUIRED_ON_BOOT=false
WEB_DIST_PATH=apps/api/dist/web

# ── CORS: dominio(s) del frontend separados por coma ─────────────────────────
CORS_ORIGIN=https://edueats.tecnowebsupportia.com

# ── Frontend/API en el mismo subdominio (recomendado):
#    deja en index.html: <meta name="edueats-api-base" content="">
#    y el backend respondera en /api.
# ── Si la API vive en otro dominio, ajustar el meta a ese dominio.

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# Generar contraseña de aplicación en: https://myaccount.google.com/apppasswords
# Para otros proveedores (Hostinger, Outlook, Zoho, etc.) usa EMAIL_HOST/PORT.
# Si EMAIL_HOST no se define, el sistema usa fallback de Gmail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tecnowebiacol@gmail.com
EMAIL_PASS=TU_APP_PASSWORD_16_CHARS

# ── Chatbot adicional ────────────────────────────────────────────────────────
CHATBOT_LLM_ENDPOINT=https://api.groq.com/openai/v1
CHATBOT_LLM_MODEL=llama-3.3-70b-versatile
CHATBOT_API_KEY=TU_GROQ_API_KEY
CHATBOT_SYSTEM_PROMPT=Eres el asistente de EduEats. Responde de forma clara y breve.
CHATBOT_FALLBACK_MSG=No encontre informacion exacta en este momento. Intenta con otra pregunta.
CHATBOT_RATE_LIMIT_PER_MINUTE=10

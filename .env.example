# ───────────────────────────────────────────────────────────────────────────
#  EduEats v2 — variables de entorno
# ───────────────────────────────────────────────────────────────────────────
#  Este archivo es la plantilla de referencia. NO contiene secretos reales.
#
#  Setup:
#    1. Copia este archivo a edueats-v2/.env
#    2. Ajusta los valores según tu entorno (desarrollo o producción)
#    3. El código lee el .env desde edueats-v2/.env (ver apps/api/src/db/pool.ts)
#
#  IMPORTANTE: edueats-v2/.env está en .gitignore — NUNCA se commitea.
# ───────────────────────────────────────────────────────────────────────────


# ── Base de datos ─────────────────────────────────────────────────────────
# Desarrollo local (XAMPP / MAMP / MySQL local):
#   DB_HOST=127.0.0.1
# Producción Hostinger:
#   DB_HOST=localhost
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=edueat
DB_POOL_CONNECTION_LIMIT=20
DB_POOL_QUEUE_LIMIT=0
DB_REQUIRED_ON_BOOT=false


# ── Servidor ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development


# ── CORS (separar varios orígenes con coma) ──────────────────────────────
# Desarrollo: dejar el default de Vite (http://localhost:5173 y :4173)
# Producción: tu dominio real
#   CORS_ORIGIN=https://edueats.tecnowebsupportia.com
CORS_ORIGIN=http://localhost:5173,http://localhost:4173


# ── Frontend dist (producción) ───────────────────────────────────────────
# Ruta absoluta o relativa al cwd del proceso Node.
# En Hostinger el cwd del proceso es la raíz del package, así que
# `apps/api/dist/web` resuelve bien. Usar minúsculas en Linux.
WEB_DIST_PATH=apps/api/dist/web


# ── Frontend runtime API base ────────────────────────────────────────────
# Dejar vacío para mismo dominio (/api), o URL completa si la API
# vive en otro subdominio: https://api.edueats.com
EDUEATS_API_BASE=


# ── Sesiones (producción) ─────────────────────────────────────────────────
# OBLIGATORIO en producción (NODE_ENV=production). Sin esto el servidor
# no arranca.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambia-esto-en-produccion


# ── SMTP (envío de OTP por correo) ───────────────────────────────────────
# Opción A — Gmail (recomendado para equipos pequeños):
#   1. Activa verificación en 2 pasos en la cuenta de Google
#   2. Genera una contraseña de aplicación en https://myaccount.google.com/apppasswords
#   3. EMAIL_USER = tu correo, EMAIL_PASS = la contraseña de 16 chars
#
# Opción B — Hostinger / otro SMTP (definir EMAIL_HOST y EMAIL_PORT):
#   Si EMAIL_HOST no se define, el sistema usa el fallback de Gmail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx


# ── OTP (autenticación) ──────────────────────────────────────────────────
# Expiración del código en minutos (recomendado entre 5 y 10)
OTP_EXPIRES_MINUTES=5
# Máximo de OTPs por ventana y por identificador (email/código)
OTP_RATE_LIMIT_MAX=3
# Ventana en milisegundos (1 hora por defecto)
OTP_RATE_LIMIT_WINDOW_MS=3600000


# ── Chatbot (asistente IA) ───────────────────────────────────────────────
# Opcional. Sin CHATBOT_API_KEY el chatbot responde con un fallback
# genérico en lugar de llamar al LLM.
CHATBOT_LLM_ENDPOINT=https://api.groq.com/openai/v1
CHATBOT_LLM_MODEL=llama-3.3-70b-versatile
CHATBOT_API_KEY=
CHATBOT_SYSTEM_PROMPT=Eres el asistente de EduEats. Responde de forma clara y breve.
CHATBOT_FALLBACK_MSG=No encontre informacion exacta en este momento. Intenta con otra pregunta.
CHATBOT_RATE_LIMIT_PER_MINUTE=10


# ───────────────────────────────────────────────────────────────────────────
#  EJEMPLO — Valores de producción Hostinger (referencia, no usar literal)
# ───────────────────────────────────────────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=u652436213_EdueatApp
# DB_PASS=TU_PASSWORD_MYSQL
# DB_NAME=u652436213_Edueat
# DB_POOL_CONNECTION_LIMIT=30
# PORT=3001
# NODE_ENV=production
# CORS_ORIGIN=https://edueats.tecnowebsupportia.com
# SESSION_SECRET=<output del comando crypto.randomBytes(48)>
# EMAIL_USER=tecnowebiacol@gmail.com
# EMAIL_PASS=<contraseña-de-aplicación-de-16-chars>

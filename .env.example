# ── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=tu-host-mysql.hostinger.com
DB_PORT=3306
DB_USER=u123456_edueat
DB_PASS=TuPasswordSeguro
DB_NAME=u123456_edueat

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
DB_REQUIRED_ON_BOOT=true

# ── CORS: dominio(s) del frontend separados por coma ─────────────────────────
CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com

# ── Frontend: si la API vive en otro dominio, ajustar el meta
#    <meta name="edueats-api-base" content="https://api.tudominio.com">
#    en index.html antes de desplegar el frontend.

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
